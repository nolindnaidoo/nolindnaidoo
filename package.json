{
	"name": "nolindnaidoo",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && bun run hooks:install",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"e2e": "playwright test",
		"hooks:install": "git config core.hooksPath .githooks",
		"lint:commits": "node scripts/commit-lint.js --range \"${BASE_SHA:-origin/main}\" \"${HEAD_SHA:-HEAD}\"",
		"og": "bun scripts/build-og-image.ts",
		"budget": "bun scripts/check-budget.ts",
		"verify:content": "bun scripts/check-content-drift.ts",
		"test:coverage": "vitest run --coverage",
		"verify": "bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run budget && bun run verify:content && bun run e2e",
		"verify:deploy": "bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run budget"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.1",
		"@biomejs/biome": "^2.5.7",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"happy-dom": "^20.11.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1"
	}
}
